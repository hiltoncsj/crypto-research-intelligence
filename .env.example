# PostgreSQL (infrastructure/docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crypto_research?schema=public"

# Redis (infrastructure/docker-compose.yml) — usado a partir do Sprint 4 (BullMQ)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Admin single-user (Sprint 1) — gere o hash com:
# node -e "console.log(require('bcryptjs').hashSync('sua-senha', 10))"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""

# Sprint 2: chave mestra para criptografar api_connections.encrypted_secret (AES-256-GCM).
# Gere localmente com: openssl rand -hex 32
# NUNCA coloque o valor real aqui — apenas no seu .env local / secret manager do ambiente.
MASTER_ENCRYPTION_KEY=""
